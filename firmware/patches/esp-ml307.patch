 #define ESP_TCP_EVENT_RECEIVE_TASK_EXIT 1
 
 class EspTcp : public Tcp {
@@ -26,6 +28,18 @@ private:
     TaskHandle_t receive_task_handle_ = nullptr;
     int last_error_ = 0;
 
+    // StackChan local override (see components/78__esp-ml307/STACKCHAN_OVERRIDE.md
+    // for the full incident writeup): guards against DoDisconnect() being
+    // entered concurrently by two different tasks for the same connection
+    // - the task that owns this EspTcp actively closing it, and the
+    // background receive task independently discovering the same socket
+    // died - both of which would otherwise invoke disconnect_callback_()
+    // a second time on an object that isn't reentrant-safe for that. Reset
+    // at the start of each Connect() so a reused EspTcp object (if one
+    // ever is reused across multiple connections) starts each connection's
+    // lifetime with a fresh guard.
+    std::atomic<bool> disconnect_callback_fired_{false};
+
     void ReceiveTask();
     // 内部断开处理函数
     // wait_for_task: 是否等待接收任务退出（主动断开为true，被动断开为false）
